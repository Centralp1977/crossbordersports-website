---
import Layout from '../layouts/Layout.astro';
---

<Layout title="CROSSBORDER SPORTS — 日本のスポーツを、世界へ。">
<div class="art">

  <!-- ════════════════════════════════
       ①② NAV + HERO
  ════════════════════════════════ -->
  <section class="hero-wrap">

    <!-- NAV -->
    <header class="nav" id="nav">
      <a href="/" class="logo" aria-label="CROSSBORDER SPORTS">
        <span class="beb logo-x">×</span>
        <span class="logo-name">CROSS BORDER<br>SPORTS</span>
      </a>
      <button class="ham" id="ham" aria-label="メニュー">
        <span></span><span></span><span></span>
      </button>
    </header>

    <!-- DRAWER -->
    <div class="drawer" id="drawer">
      <button class="drawer-close" id="drawer-close">×</button>
      <nav class="drawer-nav">
        <a href="#about">会社概要</a>
        <a href="#services">サービス</a>
        <a href="#results">実績</a>
        <a href="#journal">ジャーナル</a>
        <a href="#contact">お問い合わせ</a>
      </nav>
    </div>

    <!-- HERO BODY -->
    <div class="hero">
      <div class="hero-left">
        <p class="hero-en beb">— WHERE SPORT MEANS JAPAN</p>
        <div class="hero-box">
          <h1 class="hero-h">「日本といえば、<br>スポーツ」の<br>世界をつくる</h1>
        </div>
        <p class="hero-body">
          日本の奥ゆかしさは、美しい。けれど、世界にはなかなか伝わらない。
          だからこそ、内と外、両方の視点を持つ私たちにできることがある。
        </p>
        <div class="hero-ctas">
          <a href="#contact" class="btn-outline">お問い合わせ →</a>
          <a href="#services" class="btn-ghost">サービスを見る</a>
        </div>
      </div>
      <div class="hero-right" aria-hidden="true">
        <img src="/hero-v1.png" alt="" class="hero-img" />
      </div>
    </div>

    <!-- STRENGTH BAR -->
    <div class="strength-bar">
      <div class="strength-bar-in">
        <div class="strength-items">
          <span class="beb si">カルチャー</span>
          <span class="beb sx">×</span>
          <span class="beb si">インパクト</span>
          <span class="beb sx">×</span>
          <span class="beb si">アピール</span>
          <span class="beb sx">×</span>
          <span class="beb si">イメージ</span>
        </div>
        <span class="beb strength-label">CROSS × 4 STRENGTHS</span>
      </div>
    </div>
  </section>


  <!-- ════════════════════════════════
       ⑥ TRUST BAR
  ════════════════════════════════ -->
  <section style="background:#0E0E0E;padding:80px 0">
    <div class="lbl wht" style="padding:0 100px;letter-spacing:.5em;font-size:11px">Trusted By</div>
    <div style="overflow:hidden;margin-top:44px">
      <div class="marq">
        <div style="display:flex;gap:48px;padding-right:48px">
          {Array.from({length:6}).map(()=>(
            <div class="trustlogo"></div>
          ))}
        </div>
        <div style="display:flex;gap:48px;padding-right:48px" aria-hidden="true">
          {Array.from({length:6}).map(()=>(
            <div class="trustlogo"></div>
          ))}
        </div>
      </div>
    </div>
  </section>


  <!-- ════════════════════════════════
       ③ NARRATION
  ════════════════════════════════ -->
  <section data-reveal style="display:flex;position:relative" class="bglt" id="about">
    <div style="width:60%;padding:100px 96px;position:relative">
      <div class="lbl blk" style="letter-spacing:.5em;font-size:11px">About ／ 私たちについて</div>
      <div class="min blk" style="font-size:26px;line-height:1.85;margin-top:52px">
        <p>日本人の謙虚さは、美しい。</p>
        <p style="margin-top:40px">でも、世界にはまだ伝わっていない。</p>
        <p style="margin-top:40px">私はイギリスで生まれ、<br>日本のスタジアムで心を奪われた。</p>
        <p style="margin-top:40px">外からの視点と、日本への深い理解。</p>
        <p style="margin-top:40px">その両方で、日本のスポーツを<br>世界の歓喜に変えたい。</p>
      </div>
      <div class="blk h9" style="font-size:15px;letter-spacing:.04em;text-align:right;margin-top:48px">ABBY HALL</div>
      <div class="min" style="font-size:12px;color:rgba(14,14,14,.6);margin-top:6px;text-align:right">Representative / CROSSBORDER SPORTS</div>
    </div>
    <!-- Photos (right 40%) -->
    <div style="position:relative;width:40%;min-height:640px">
      <div class="phl" style="position:absolute;right:40px;top:40px;width:320px;height:420px;border-radius:8px">
        <div class="phlabd" style="position:absolute;top:50%;left:0;right:0;transform:translateY(-50%)">過去のお写真など</div>
      </div>
      <div class="phl" style="position:absolute;right:80px;bottom:40px;width:260px;height:300px;border-radius:8px">
        <div class="phlabd" style="position:absolute;top:50%;left:0;right:0;transform:translateY(-50%)">お写真</div>
      </div>
    </div>
  </section>


  <!-- ════════════════════════════════
       ④ PHILOSOPHY ×
  ════════════════════════════════ -->
  <section data-reveal style="position:relative;height:600px;background:#fff;overflow:hidden">
    <div class="beb" style="position:absolute;left:50%;top:50%;transform:translate(-50%,-52%);font-size:560px;line-height:.8;color:#C41230;opacity:.1;pointer-events:none">×</div>
    <div class="lbl blk" style="position:absolute;top:56px;left:100px;letter-spacing:.5em;font-size:12px">Philosophy</div>
    <div class="goth h9 blk" style="position:absolute;left:120px;top:50%;transform:translateY(-50%);font-size:38px">外からの視点</div>
    <div class="goth h9 blk" style="position:absolute;right:120px;top:50%;transform:translateY(-50%);font-size:38px">日本への深い理解</div>
    <div class="min blk" style="position:absolute;font-size:18px;font-style:italic;left:50%;bottom:60px;transform:translateX(-50%);white-space:nowrap">だからこそ、私たちにできることがある。</div>
  </section>


  <!-- ════════════════════════════════
       ⑤ FOUR STRENGTHS
  ════════════════════════════════ -->
  <section data-reveal class="sec bglt" id="results">
    <div class="lbl blk">Four Strengths ／ 4つの強み</div>
    <h2 class="goth h9 blk" style="font-size:38px;line-height:1.4;max-width:880px;margin-top:36px">
      感情×戦略×文化×発信。<br>4つの交点に、CBSがいる。
    </h2>
    <div style="position:relative;margin-top:64px">
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:2px">
        <div class="card">
          <div class="crim h9" style="font-size:14px">01</div>
          <div class="goth h9 blk" style="font-size:28px;margin-top:14px">カルチャー</div>
          <div class="lbl blk" style="font-size:11px;margin-top:6px">Culture</div>
          <p class="min blk" style="font-size:15px;line-height:1.8;margin-top:18px">日本のスポーツ文化を、世界の文脈に翻訳する。</p>
        </div>
        <div class="card">
          <div class="crim h9" style="font-size:14px">02</div>
          <div class="goth h9 blk" style="font-size:28px;margin-top:14px">インパクト</div>
          <div class="lbl blk" style="font-size:11px;margin-top:6px">Impact</div>
          <p class="min blk" style="font-size:15px;line-height:1.8;margin-top:18px">感情を動かすコンテンツで、熱狂を設計する。</p>
        </div>
        <div class="card">
          <div class="crim h9" style="font-size:14px">03</div>
          <div class="goth h9 blk" style="font-size:28px;margin-top:14px">アピール</div>
          <div class="lbl blk" style="font-size:11px;margin-top:6px">Appeal</div>
          <p class="min blk" style="font-size:15px;line-height:1.8;margin-top:18px">日本のスポーツの魅力を、最大化して届ける。</p>
        </div>
        <div class="card">
          <div class="crim h9" style="font-size:14px">04</div>
          <div class="goth h9 blk" style="font-size:28px;margin-top:14px">イメージ</div>
          <div class="lbl blk" style="font-size:11px;margin-top:6px">Image</div>
          <p class="min blk" style="font-size:15px;line-height:1.8;margin-top:18px">世界が抱く"日本"のイメージを、スポーツで塗り替える。</p>
        </div>
      </div>
      <div class="beb" style="position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);width:48px;height:48px;background:#F3F1EC;display:flex;align-items:center;justify-content:center;color:#C41230;font-size:34px;z-index:2">×</div>
    </div>
  </section>


  <!-- ════════════════════════════════
       ⑦ SERVICES
  ════════════════════════════════ -->
  <section data-reveal class="sec bglt" id="services">
    <div class="lbl blk">Services ／ サービス</div>
    <h2 class="goth h9 blk" style="font-size:48px;margin-top:32px">熱を、世界の言語に翻訳する。</h2>
    <p class="min blk" style="font-size:18px;line-height:1.7;margin-top:20px">戦略を立てる、発信する、メディアに届ける。</p>
    <div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:48px;margin-top:64px">

      <div>
        <svg width="44" height="44" viewBox="0 0 44 44" fill="none" stroke="#C41230" stroke-width="2">
          <circle cx="22" cy="22" r="14"/><circle cx="22" cy="22" r="5"/>
          <line x1="22" y1="2" x2="22" y2="9"/><line x1="22" y1="35" x2="22" y2="42"/>
          <line x1="2" y1="22" x2="9" y2="22"/><line x1="35" y1="22" x2="42" y2="22"/>
        </svg>
        <div class="cat" style="margin-top:20px">戦略を立てる</div>
        <div class="svc" style="margin-top:24px">
          <div class="sn">グローバル戦略<br>コンサルティング</div>
          <div class="sb">海外展開の方針立案から実行までの戦略的アドバイス。</div>
        </div>
        <div class="svc" style="margin-top:2px">
          <div class="sn">海外ステークホルダー調整</div>
          <div class="sb">国際連盟・スポンサー・パートナーとの関係構築。</div>
        </div>
      </div>

      <div>
        <svg width="44" height="44" viewBox="0 0 44 44" fill="none" stroke="#C41230" stroke-width="2" stroke-linecap="round">
          <circle cx="22" cy="22" r="3.5" fill="#C41230" stroke="none"/>
          <path d="M13 13 A13 13 0 0 0 13 31"/>
          <path d="M31 13 A13 13 0 0 1 31 31"/>
          <path d="M7 7 A21 21 0 0 0 7 37"/>
          <path d="M37 7 A21 21 0 0 1 37 37"/>
        </svg>
        <div class="cat" style="margin-top:20px">発信する</div>
        <div class="svc" style="margin-top:24px">
          <div class="sn">英語SNS運用・<br>コンテンツ制作</div>
          <div class="sb">英語ネイティブが手がける投稿作成・アカウント運用。</div>
        </div>
        <div class="svc" style="margin-top:2px">
          <div class="sn">英語プレスリリース<br>作成・翻訳</div>
          <div class="sb">伝わる英語で書いたプレスリリースと自然な翻訳。</div>
        </div>
      </div>

      <div>
        <svg width="44" height="44" viewBox="0 0 44 44" fill="none" stroke="#C41230" stroke-width="2" stroke-linejoin="round" stroke-linecap="round">
          <path d="M5 22 L39 7 L31 39 L22 26 Z"/>
          <line x1="22" y1="26" x2="39" y2="7"/>
        </svg>
        <div class="cat" style="margin-top:20px">メディアに届ける</div>
        <div class="svc" style="margin-top:24px">
          <div class="sn">海外メディア対応・<br>PR支援</div>
          <div class="sb">海外メディアへのアプローチから取材対応まで。</div>
        </div>
        <div class="svc" style="margin-top:2px">
          <div class="sn">海外メディア<br>トレーニング</div>
          <div class="sb">取材・インタビュー・登壇に向けた実践的トレーニング。</div>
        </div>
      </div>

    </div>
  </section>


  <!-- ════════════════════════════════
       ⑧ THE GAZE / STORY
  ════════════════════════════════ -->
  <section data-reveal style="display:flex;background:#fff" id="journal">
    <div style="width:55%;padding:110px 96px">
      <div class="lbl crim">Story ／ 物語</div>
      <div class="min blk" style="font-size:48px;line-height:1.4;margin-top:44px">日本のスポーツファンに、<br>恋をした。</div>
      <div class="goth blk" style="font-size:14px;letter-spacing:.2em;margin-top:32px">── ABBY HALL</div>
      <p class="min blk" style="font-size:16px;line-height:1.9;max-width:460px;margin-top:36px">
        ある日、彼女はスタジアムで日本のファンに出会い、その熱狂に心を奪われた。外からの視点だからこそ見える、日本のスポーツの本質的な美しさ。
      </p>
      <a class="cld" href="#" style="margin-top:40px;display:inline-block">ロングインタビューを読む →</a>
    </div>
    <div class="phl" style="width:45%;position:relative;min-height:580px">
      <div class="phlabd" style="position:absolute;top:48%;left:0;right:0">[ ABBY — cinematic vertical portrait ]</div>
    </div>
  </section>


  <!-- ════════════════════════════════
       N NEWS
  ════════════════════════════════ -->
  <section data-reveal class="sec bgwh">
    <div style="display:flex;align-items:flex-end;justify-content:space-between">
      <div>
        <div class="lbl crim" style="font-size:30px">News ／ ニュース</div>
        <h2 class="goth h9 blk" style="font-size:40px;margin-top:28px">最新のうごき。</h2>
      </div>
      <a class="cld" href="#">ニュース一覧へ →</a>
    </div>
    <div style="margin-top:48px;border-bottom:1px solid rgba(14,14,14,.16)">
      <a class="newsrow" href="#">
        <span class="ndate">2026.05.20</span>
        <span class="ncat">PRESS</span>
        <span class="ntitle">CROSSBORDER SPORTS、海外PR支援プログラムを始動。</span>
        <span class="beb crim" style="font-size:20px">→</span>
      </a>
      <a class="newsrow" href="#">
        <span class="ndate">2026.04.12</span>
        <span class="ncat">EVENT</span>
        <span class="ntitle">代表アビー・ホール、国際スポーツカンファレンスに登壇。</span>
        <span class="beb crim" style="font-size:20px">→</span>
      </a>
      <a class="newsrow" href="#">
        <span class="ndate">2026.03.03</span>
        <span class="ncat">JOURNAL</span>
        <span class="ntitle">「恋をした」── 代表ロングインタビューを公開しました。</span>
        <span class="beb crim" style="font-size:20px">→</span>
      </a>
    </div>
  </section>


  <!-- ════════════════════════════════
       ⑨ CONTACT CTA
  ════════════════════════════════ -->
  <section data-reveal style="background:#C41230;padding:120px 100px;text-align:center" id="contact">
    <h2 class="goth h9 wht" style="font-size:64px">あなたの熱を、世界へ。</h2>
    <p class="min wht" style="font-size:18px;margin-top:24px;opacity:.92">プロジェクトのご相談・お見積もりはお気軽に。</p>
    <div style="margin-top:48px">
      <button class="ctab">お問い合わせフォームへ →</button>
    </div>
    <div class="beb" style="margin-top:22px;font-size:11px;letter-spacing:.2em;color:rgba(255,255,255,.45)">[ HubSpot Form Embed ]</div>
  </section>


  <!-- ════════════════════════════════
       ⑩ FOOTER
  ════════════════════════════════ -->
  <footer style="background:#0E0E0E;padding:56px 100px">
    <div style="display:flex;align-items:center;justify-content:space-between">
      <div style="display:flex;align-items:center;gap:12px">
        <div style="width:28px;height:28px;border:1.5px solid #C41230;border-radius:50%;display:flex;align-items:center;justify-content:center">
          <span class="beb crim" style="font-size:16px">×</span>
        </div>
        <span class="wht h9" style="font-size:13px;letter-spacing:.16em">CROSSBORDER SPORTS</span>
      </div>
      <div style="display:flex;gap:36px">
        <a class="flk" href="#about">会社概要</a>
        <a class="flk" href="#services">サービス</a>
        <a class="flk" href="#results">実績</a>
        <a class="flk" href="#journal">ジャーナル</a>
        <a class="flk" href="#contact">お問い合わせ</a>
      </div>
      <div style="display:flex;gap:12px">
        <div class="soc">IG</div>
        <div class="soc">X</div>
        <div class="soc">Note</div>
      </div>
    </div>
    <div style="height:1px;background:rgba(255,255,255,.12);margin:40px 0"></div>
    <div class="beb" style="text-align:center;font-size:11px;letter-spacing:.22em;color:rgba(255,255,255,.4)">© 2026 CROSSBORDER SPORTS. All rights reserved.</div>
  </footer>

</div><!-- /.art -->
</Layout>


<style>
  /* ── COMP BASE ── */
  * { margin:0; padding:0; box-sizing:border-box }

  .art {
    width: 100%;
    max-width: 1440px;
    margin: 0 auto;
    background: #fff;
    overflow: hidden;
    font-family: 'Noto Sans JP', sans-serif;
  }

  .beb  { font-family: 'Bebas Neue', sans-serif; font-weight: 400 }
  .min  { font-family: 'Noto Serif JP', serif }
  .goth { font-family: 'Noto Sans JP', sans-serif }
  .h9   { font-weight: 900 }
  .crim { color: #C41230 }
  .wht  { color: #fff }
  .blk  { color: #0E0E0E }
  .bglt { background: #F3F1EC }
  .bgwh { background: #fff }
  .lbl  { font-family:'Bebas Neue',sans-serif; text-transform:uppercase; letter-spacing:.38em; font-size:14px }
  .sec  { padding: 100px }

  .phl  { background:#e6e3db repeating-linear-gradient(45deg,rgba(0,0,0,.05) 0 14px,transparent 14px 28px) }
  .phlabd { font-family:'Bebas Neue',sans-serif; letter-spacing:.3em; font-size:13px; color:rgba(14,14,14,.42); text-align:center }

  .card { background:#fff; border-top:2px solid #0E0E0E; padding:42px }

  .svc  { background:#fff; border-top:1.5px solid #0E0E0E; padding:32px }
  .svc .sn { font-weight:900; font-size:21px; color:#0E0E0E; line-height:1.35 }
  .svc .sb { font-family:'Noto Serif JP',serif; font-size:15px; color:#0E0E0E; line-height:1.8; margin-top:14px }

  .cat { font-weight:900; font-size:22px; color:#0E0E0E; border-bottom:2px solid #C41230; padding-bottom:12px }

  .flk { color:rgba(255,255,255,.7); font-size:12px; letter-spacing:.14em; text-decoration:none; transition:color .2s }
  .flk:hover { color:#fff }

  .marq { display:flex; width:max-content; animation:marq 20s linear infinite }
  @keyframes marq { to { transform:translateX(-50%) } }

  .trustlogo {
    width:160px; height:48px; background:rgba(255,255,255,.12); flex:none;
    display:flex; align-items:center; justify-content:center;
    font-family:'Bebas Neue',sans-serif; letter-spacing:.3em; font-size:12px; color:rgba(255,255,255,.42)
  }
  .trustlogo::before { content:'LOGO' }

  .ctab {
    background:#fff; color:#C41230; font-weight:900; font-size:16px;
    padding:18px 48px; border:none; display:inline-flex; align-items:center; gap:12px;
    cursor:pointer; font-family:'Noto Sans JP',sans-serif; transition:opacity .2s
  }
  .ctab:hover { opacity:.88 }

  .cld {
    color:#0E0E0E; font-weight:700; font-size:15px;
    border-bottom:2px solid #C41230; padding-bottom:4px; text-decoration:none;
    transition:color .2s
  }
  .cld:hover { color:#C41230 }

  .soc {
    width:36px; height:36px; border:1px solid rgba(255,255,255,.5);
    display:flex; align-items:center; justify-content:center;
    font-size:11px; color:rgba(255,255,255,.75); font-weight:700; cursor:pointer
  }

  .newsrow {
    display:flex; align-items:center; gap:40px; padding:30px 0;
    border-top:1px solid rgba(14,14,14,.16); text-decoration:none; transition:background .15s
  }
  .newsrow:hover { background:rgba(14,14,14,.02) }
  .ndate  { font-family:'Bebas Neue',sans-serif; letter-spacing:.1em; font-size:18px; color:#C41230; width:110px; flex:none }
  .ncat   { font-family:'Bebas Neue',sans-serif; letter-spacing:.22em; font-size:11px; color:#0E0E0E; border:1px solid #0E0E0E; padding:4px 12px; width:96px; text-align:center; flex:none }
  .ntitle { font-family:'Noto Serif JP',serif; font-size:18px; color:#0E0E0E; flex:1; line-height:1.6 }

  /* ── HERO WRAP ── */
  .hero-wrap { position:relative }

  /* ── NAV ── */
  .nav {
    position:absolute; top:0; left:0; right:0; z-index:50;
    display:flex; align-items:center; justify-content:space-between;
    padding:22px 44px;
  }
  .logo { display:flex; align-items:center; gap:6px; text-decoration:none; line-height:1.1 }
  .logo-x { font-size:22px; color:#C41230; line-height:1; flex:none }
  .logo-name { font-weight:900; font-size:11px; letter-spacing:.08em; color:#0E0E0E; line-height:1.3 }

  .ham {
    background:none; border:none; cursor:pointer; padding:8px;
    display:flex; flex-direction:column; gap:5px;
  }
  .ham span { display:block; width:24px; height:2px; background:#0E0E0E; transition:background .2s }
  .ham:hover span { background:#C41230 }

  /* ── DRAWER ── */
  .drawer {
    position:fixed; top:0; right:-300px; width:280px; height:100vh;
    background:#fff; z-index:200; transition:right .3s ease;
    box-shadow:-4px 0 24px rgba(0,0,0,.12);
    padding:72px 48px 48px;
  }
  .drawer.open { right:0 }
  .drawer-close {
    position:absolute; top:24px; right:24px;
    background:none; border:none; font-size:22px; cursor:pointer; color:#0E0E0E;
    font-family:'Bebas Neue',sans-serif;
  }
  .drawer-nav { display:flex; flex-direction:column; gap:28px }
  .drawer-nav a {
    text-decoration:none; font-weight:700; font-size:17px; color:#0E0E0E;
    letter-spacing:.04em; transition:color .2s;
  }
  .drawer-nav a:hover { color:#C41230 }

  /* ── HERO ── */
  .hero {
    display:flex;
    min-height:680px;
    position:relative;
  }
  .hero-left {
    position:relative; z-index:2;
    width:44%; padding:130px 52px 60px;
    background:#fff;
    display:flex; flex-direction:column; gap:0;
  }
  .hero-en {
    font-size:12px; letter-spacing:.34em; color:#C5A028;
    margin-bottom:22px;
  }
  .hero-box {
    background:#C41230; padding:18px 22px 22px; margin-bottom:26px; display:inline-block;
  }
  .hero-h {
    font-weight:900; font-size:34px; line-height:1.38; color:#fff;
  }
  .hero-body {
    font-size:13px; line-height:1.9; color:rgba(14,14,14,.65);
    margin-bottom:32px; max-width:340px;
  }
  .hero-ctas { display:flex; gap:16px; align-items:center; flex-wrap:wrap }
  .btn-outline {
    display:inline-flex; align-items:center; gap:8px;
    border:2px solid #C41230; color:#C41230;
    font-weight:900; font-size:14px; padding:13px 28px;
    text-decoration:none; background:#fff; transition:background .2s,color .2s;
  }
  .btn-outline:hover { background:#C41230; color:#fff }
  .btn-ghost {
    font-weight:700; font-size:14px; color:#0E0E0E;
    text-decoration:none; border-bottom:1.5px solid rgba(14,14,14,.3);
    padding-bottom:2px; transition:color .2s,border-color .2s;
  }
  .btn-ghost:hover { color:#C41230; border-color:#C41230 }

  .hero-right {
    position:absolute; top:0; bottom:0; right:0;
    left:40%; overflow:hidden;
  }
  .hero-img {
    width:100%; height:100%;
    object-fit:cover; object-position:right center;
  }

  /* ── STRENGTH BAR ── */
  .strength-bar { background:#C41230; padding:0 52px }
  .strength-bar-in {
    display:flex; align-items:center; justify-content:space-between; height:52px;
  }
  .strength-items { display:flex; align-items:center; gap:12px }
  .si { font-size:14px; letter-spacing:.16em; color:#fff }
  .sx { font-size:16px; color:rgba(255,255,255,.55) }
  .strength-label { font-size:11px; letter-spacing:.28em; color:rgba(255,255,255,.55) }

  /* ── SCROLL REVEAL (initial state) ── */
  [data-reveal] { opacity:0; transform:translateY(32px); transition:opacity .8s ease,transform .8s ease }
  [data-reveal].visible { opacity:1; transform:none }
</style>


<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  /* --- Drawer --- */
  const ham = document.getElementById('ham');
  const drawer = document.getElementById('drawer');
  const close = document.getElementById('drawer-close');
  ham?.addEventListener('click', () => drawer?.classList.toggle('open'));
  close?.addEventListener('click', () => drawer?.classList.remove('open'));
  document.addEventListener('click', (e) => {
    if (!drawer?.contains(e.target as Node) && !ham?.contains(e.target as Node)) {
      drawer?.classList.remove('open');
    }
  });

  /* --- Hero entrance --- */
  const tl = gsap.timeline({ defaults: { ease: 'power3.out' } });
  tl.from('.hero-en',   { opacity:0, y:14, duration:.7 }, .35)
    .from('.hero-box',  { opacity:0, x:-20, duration:.8 }, .55)
    .from('.hero-body', { opacity:0, y:12, duration:.7 }, .8)
    .from('.hero-ctas', { opacity:0, y:12, duration:.7 }, 1.0)
    .from('.strength-bar', { opacity:0, duration:.5 }, 1.2);

  /* --- Section reveal via IntersectionObserver --- */
  const observer = new IntersectionObserver(
    (entries) => entries.forEach(e => { if (e.isIntersecting) e.target.classList.add('visible') }),
    { threshold: 0.1 }
  );
  document.querySelectorAll('[data-reveal]').forEach(el => observer.observe(el));
</script>
