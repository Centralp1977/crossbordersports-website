</footer>

<style>
  * { box-sizing: border-box; margin: 0; padding: 0; }
  html { scroll-behavior: smooth; }
  body { background: #0E0E0E; font-family: 'Noto Sans JP', sans-serif; color: #fff; overflow-x: hidden; }

  /* Typography */
  .g  { font-family: 'Noto Sans JP', sans-serif; }
  .m  { font-family: 'Noto Serif JP', serif; }
  .cr { color: #C41230; }
  .heavy { font-weight: 900; letter-spacing: -.01em; line-height: 1.06; }
  .eye { font-weight: 700; font-size: 10px; letter-spacing: .42em; text-transform: uppercase; }
  .note { font-family: 'Noto Sans JP', monospace; font-size: 10px; letter-spacing: .04em; color: rgba(150,148,140,.7); }

  /* Layout */
  .wrap { max-width: 1200px; margin: 0 auto; padding: 0 clamp(24px, 8%, 120px); }
  .fx { display: flex; }
  .sec { position: relative; width: 100%; }

  /* Placeholders */
  .ph  { position: relative; overflow: hidden; background: repeating-linear-gradient(135deg,#191919,#191919 9px,#1f1f1f 9px,#1f1f1f 18px); }
  .phl { position: relative; overflow: hidden; background: repeating-linear-gradient(135deg,#e7e1d4,#e7e1d4 9px,#ece6da 9px,#ece6da 18px); }
  .phcap { position: absolute; left: 50%; top: 50%; transform: translate(-50%,-50%); font-family: 'Noto Sans JP', monospace; font-size: 11px; letter-spacing: .06em; color: rgba(220,215,205,.6); text-align: center; white-space: nowrap; font-weight: 500; }
  .phl .phcap { color: rgba(90,84,74,.55); }

  /* Nav */
  .nav { position: fixed; top: 0; left: 0; width: 100%; height: 60px; display: flex; align-items: center; justify-content: space-between; padding: 0 40px; z-index: 100; background: rgba(14,14,14,.0); transition: background .4s, backdrop-filter .4s; }
  .nav.scrolled { background: rgba(14,14,14,.92); backdrop-filter: blur(12px); }
  .logo { display: flex; align-items: center; gap: 12px; }
  .logox { width: 30px; height: 30px; border-radius: 50%; border: 1.5px solid rgba(255,255,255,.55); display: flex; align-items: center; justify-content: center; font-weight: 900; font-size: 16px; color: #C41230; line-height: 1; }
  .navlinks { display: flex; align-items: center; gap: 32px; }
  .navlink { color: #fff; font-size: 13px; letter-spacing: .18em; font-weight: 500; text-decoration: none; opacity: .85; transition: opacity .2s; }
  .navlink:hover { opacity: 1; }

  /* Pill button */
  .pill { display: inline-flex; align-items: center; gap: 8px; border-radius: 100px; font-weight: 700; font-size: 13px; cursor: pointer; text-decoration: none; transition: opacity .2s; }
  .pill:hover { opacity: .85; }

  /* Hero */
  .hero { position: relative; height: 100svh; min-height: 600px; background: #0E0E0E; overflow: hidden; }
  .quad { position: absolute; inset: 0; }
  .xline { position: absolute; left: 50%; top: 50%; width: 200vw; height: 18px; background: #fff; transform-origin: center; z-index: 5; opacity: 0; }
  #xline1 { transform: translate(-50%, -50%) rotate(26.5deg); }
  #xline2 { transform: translate(-50%, -50%) rotate(-26.5deg); }
  .hbloom { position: absolute; left: 50%; top: 50%; width: 60vw; height: 50vh; transform: translate(-50%,-50%); background: radial-gradient(ellipse at center,rgba(255,255,255,.16),rgba(255,255,255,0) 70%); z-index: 5; }
  .hcenter { position: absolute; left: 50%; top: 50%; transform: translate(-50%,-50%); z-index: 7; text-align: center; width: 100%; }
  .hpanel { display: inline-block; padding: 30px 60px; background: rgba(14,14,14,.34); backdrop-filter: blur(2px); }
  .heroH { font-weight: 900; font-size: clamp(40px, 5vw, 64px); color: #fff; line-height: 1.12; }
  .ticker { position: absolute; right: 32px; bottom: 30px; z-index: 8; background: rgba(20,20,20,.82); color: #fff; font-size: 11px; font-weight: 500; padding: 9px 16px; border-radius: 100px; letter-spacing: .02em; }
  .ticker b { color: #C41230; font-weight: 900; margin-right: 8px; }

  /* Strengths */
  .strengths-grid { display: grid; grid-template-columns: 1fr auto 1fr; gap: 40px; align-items: center; }
  .strengths-col { display: flex; flex-direction: column; gap: 48px; }
  .fsh { font-weight: 900; font-size: 28px; color: #fff; }
  .fsd { margin-top: 10px; font-size: 14px; line-height: 1.85; color: rgba(255,255,255,.75); max-width: 300px; }
  .strengths-col[style*="flex-end"] .fsd { margin-left: auto; }

  /* Trust */
  .lstrip { width: 100px; height: 36px; border: .5px solid rgba(255,255,255,.25); border-radius: 4px; display: flex; align-items: center; justify-content: center; }

  /* Services */
  .svrow { display: flex; gap: 56px; align-items: flex-start; }
  .svcard { width: 40%; flex-shrink: 0; background: #111; border: 1px solid rgba(255,255,255,.12); border-radius: 10px; padding: 24px; }
  .svdetail { flex: 1; }
  .svrule { height: 1px; background: rgba(255,255,255,.08); margin: 64px 0; }

  /* Circle arrow */
  .cmore { display: inline-flex; align-items: center; gap: 12px; font-weight: 700; font-size: 14px; text-decoration: none; }
  .carrow { width: 30px; height: 30px; border-radius: 50%; border: 1.5px solid currentColor; display: flex; align-items: center; justify-content: center; font-size: 13px; }

  /* Journal */
  .journal-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 40px; }
  .journal-card {}
  .jtitle { font-weight: 900; font-size: 17px; line-height: 1.4; color: #0E0E0E; }
  .tabpill { border-radius: 100px; font-size: 13px; font-weight: 700; padding: 8px 20px; cursor: pointer; }
  .tabon  { background: #0E0E0E; color: #fff; }
  .taboff { background: transparent; color: #0E0E0E; border: 1px solid rgba(14,14,14,.4); }
  .tagpill { border: 1px solid rgba(14,14,14,.55); color: #0E0E0E; border-radius: 100px; font-size: 10px; font-weight: 700; padding: 4px 12px; }

  /* Footer */
  .fcolh { font-weight: 900; font-size: 14px; color: #fff; margin-bottom: 14px; letter-spacing: .08em; }
  .flink { display: block; color: rgba(255,255,255,.55); font-size: 12px; font-weight: 500; text-decoration: none; margin-bottom: 9px; transition: color .2s; }
  .flink:hover { color: #fff; }
  .soc { width: 32px; height: 32px; border: 1px solid rgba(255,255,255,.4); border-radius: 4px; display: flex; align-items: center; justify-content: center; color: rgba(255,255,255,.7); font-size: 11px; font-weight: 700; cursor: pointer; }

  /* Reveal animation */
  .reveal { opacity: 0; transform: translateY(32px); transition: opacity .7s ease, transform .7s ease; }
  .reveal.visible { opacity: 1; transform: translateY(0); }

  /* Responsive */
  @media (max-width: 768px) {
    .navlinks { display: none; }
    .hpanel { padding: 20px 24px; }
    .strengths-grid { grid-template-columns: 1fr; }
    .svrow { flex-direction: column; }
    .svcard { width: 100%; }
    .journal-grid { grid-template-columns: 1fr; }
    .wrap > div[style*="grid-template-columns: repeat(5"] { grid-template-columns: repeat(2,1fr) !important; }
  }
</style>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  // Nav scroll behavior
  const nav = document.getElementById('nav');
  window.addEventListener('scroll', () => {
    nav?.classList.toggle('scrolled', window.scrollY > 40);
  });

  // Hero: crossing X lines animate in
  gsap.timeline({ delay: 0.3 })
    .to('#xline1', { opacity: 0.06, duration: 1, ease: 'power2.out' }, 0)
    .to('#xline2', { opacity: 0.06, duration: 1, ease: 'power2.out' }, 0.1)
    .from('#hero-center', { opacity: 0, y: 24, duration: 1, ease: 'power3.out' }, 0.4);

  // X SVG animate on scroll
  ScrollTrigger.create({
    trigger: '#strengths',
    start: 'top 70%',
    onEnter: () => {
      gsap.from('#x-svg line', {
        drawSVG: '0%',
        duration: 0.8,
        stagger: 0.12,
        ease: 'power2.inOut',
      });
      gsap.from('#x-svg circle', { scale: 0, transformOrigin: 'center', duration: 0.5, delay: 0.5, ease: 'back.out(2)' });
    },
    once: true,
  });

  // Scroll reveal for sections
  document.querySelectorAll('.reveal').forEach((el) => {
    ScrollTrigger.create({
      trigger: el,
      start: 'top 82%',
      onEnter: () => el.classList.add('visible'),
    });
  });
</script>

</body>
</html>
