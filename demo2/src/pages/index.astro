---
// 末尾スラッシュを必ず1つに正規化（base設定の末尾スラッシュ有無に依存しないため）
const base = import.meta.env.BASE_URL.replace(/\/$/, '') + '/';
---
<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="utf-8" />
  <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="generator" content={Astro.generator} />
  <title>CROSS BORDER SPORTS — The Cross</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="" />
  <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@500;700;900&family=Noto+Serif+JP:wght@400;500;600&display=swap" rel="stylesheet" />
</head>
<body>

<!-- ① NAV -->
<header class="nav" id="nav">
  <div class="logo">
    <span class="logox">×</span>
    <span class="g" style="font-size:13px;font-weight:700;letter-spacing:.3em">CROSS BORDER SPORTS</span>
  </div>
  <nav class="navlinks">
    <a class="navlink" href="#philosophy">About</a>
    <a class="navlink" href="#services">サービス</a>
    <a class="navlink" href="#strengths">強み</a>
    <a class="navlink" href="#journal">ニュース</a>
  </nav>
  <div style="display:flex;align-items:center;gap:16px">
    <span class="g" style="font-size:11px;letter-spacing:.18em;color:rgba(255,255,255,.85)">JP <span style="opacity:.4">/ EN</span></span>
    <a class="pill" href="#contact" style="background:#C41230;color:#fff;padding:10px 22px">Contact →</a>
  </div>
</header>

<!-- ② HERO -->
<section class="hero" id="hero">
  <div class="quad" style="clip-path:polygon(0 0,100% 0,50% 50%);background:linear-gradient(180deg,rgba(196,18,48,.18),rgba(14,14,14,.55))"></div>
  <div class="quad" style="clip-path:polygon(100% 0,100% 100%,50% 50%);background:linear-gradient(270deg,rgba(196,18,48,.16),rgba(14,14,14,.5))"></div>
  <div class="quad" style="clip-path:polygon(0 100%,100% 100%,50% 50%);background:linear-gradient(0deg,rgba(196,18,48,.30),rgba(14,14,14,.5))"></div>
  <div class="quad" style="clip-path:polygon(0 0,0 100%,50% 50%);background:linear-gradient(90deg,rgba(196,18,48,.12),rgba(14,14,14,.55))"></div>

  <img src={`${base}images/hero.png`} alt="CBS hero — THE CROSSING" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;z-index:1;" />
  <div class="xline" id="xline1"></div>
  <div class="xline" id="xline2"></div>
  <div class="hbloom"></div>

  <div class="hcenter" id="hero-center">
    <div class="hpanel">
      <div class="eye" style="color:rgba(255,255,255,.85);margin-bottom:20px">CROSS BORDER SPORTS</div>
      <div class="heroH">日本<span class="cr" style="font-size:72px">×</span>文化＝</div>
      <div class="heroH" style="margin-top:4px">スポーツをつくる</div>
      <div class="g" style="margin-top:18px;font-size:14px;letter-spacing:.3em;color:rgba(255,255,255,.7)">CROSSBORDER SPORTS</div>
    </div>
    <div style="display:flex;align-items:center;justify-content:center;gap:16px;margin-top:34px">
      <a class="pill" href="#services" style="background:#0E0E0E;color:#fff;padding:14px 30px;font-size:14px;border:1px solid rgba(255,255,255,.3)">Service →</a>
      <a class="pill" href="#contact" style="background:#C41230;color:#fff;padding:14px 30px;font-size:14px">Contact →</a>
    </div>
  </div>

  <div class="ticker"><b>2026.01</b>新しいサービスを開始しました</div>
</section>

<!-- TRUST BAR -->
<section style="background:#161616;border-top:2px solid #C41230;padding:0">
  <div class="wrap" style="display:flex;align-items:center;justify-content:center;padding:28px 120px;gap:0">
    <div style="flex:1;text-align:center">
      <span class="g heavy" style="font-size:36px;color:#fff">３０</span>
      <span class="m" style="margin-left:14px;font-size:13px;color:rgba(255,255,255,.6)">プロジェクト</span>
    </div>
    <div style="width:1px;height:36px;background:rgba(255,255,255,.15)"></div>
    <div style="flex:1;text-align:center">
      <span class="g heavy" style="font-size:36px;color:#fff">１０</span>
      <span class="m" style="margin-left:14px;font-size:13px;color:rgba(255,255,255,.6)">スポーツチーム</span>
    </div>
    <div style="width:1px;height:36px;background:rgba(255,255,255,.15)"></div>
    <div style="flex:1;display:flex;align-items:center;justify-content:center;gap:12px">
      <div class="lstrip"><span class="note" style="color:rgba(255,255,255,.35);font-size:11px">PARTNER</span></div>
      <div class="lstrip"><span class="note" style="color:rgba(255,255,255,.35);font-size:11px">PARTNER</span></div>
      <div class="lstrip"><span class="note" style="color:rgba(255,255,255,.35);font-size:11px">PARTNER</span></div>
    </div>
  </div>
</section>

<!-- ④ PHILOSOPHY -->
<section class="sec" id="philosophy" style="background:#F3F1EC;padding:120px 0">
  <div class="wrap fx reveal">
    <div style="width:58%">
      <div class="eye cr" style="margin-bottom:26px">PHILOSOPHY ／ CBSの哲学</div>
      <div class="heavy" style="font-size:clamp(36px,4vw,60px);color:#0E0E0E;line-height:1.14">
        日本人の謙虚さは、<br>美しい。<br>でも、世界には<br>伝わらない。
      </div>
      <div class="m" style="margin-top:40px;max-width:480px;font-size:18px;line-height:1.95;color:#23211d">
        だからこそ、内と外、両方の視点を持つ私たちにできることがある。外国人の視点と、日本への深い理解。その両方を持つCBSにしかできないことがある。
      </div>
    </div>
    <div style="width:42%"></div>
  </div>
</section>

<!-- ⑤ PORTRAIT -->
<section class="sec" style="background:#F3F1EC;padding:40px 0 130px">
  <div style="position:relative;max-width:1200px;margin:0 auto;height:560px;padding:0 120px" class="reveal">
    <div class="ph" style="position:absolute;right:30px;top:20px;width:420px;height:520px;border-radius:12px">
      <div class="phcap">［ stadium · crimson & black ］</div>
    </div>
    <div class="phl" style="position:absolute;left:380px;top:240px;width:300px;height:380px;border-radius:12px;border:2px solid #fff;box-shadow:0 14px 40px rgba(0,0,0,.16)">
      <div class="phcap">［ Abby Hall portrait ］</div>
    </div>
    <div style="position:relative;z-index:2;padding-top:30px">
      <div class="m" style="font-size:28px;line-height:1.8;color:#0E0E0E;font-weight:500">「日本のスポーツに、恋をした。」</div>
      <div class="g heavy" style="font-size:26px;color:#0E0E0E;margin-top:12px">ABBY HALL</div>
      <div class="g" style="margin-top:8px;font-size:13px;font-weight:500;color:rgba(14,14,14,.6);letter-spacing:.04em">Representative ／ CROSSBORDER SPORTS</div>
      <a class="cmore" href="#" style="color:#0E0E0E;margin-top:40px;display:inline-flex;align-items:center;gap:12px;font-weight:700;font-size:14px;text-decoration:none">
        <span class="carrow">→</span>View more
      </a>
    </div>
  </div>
</section>

<!-- ⑥ FOUR STRENGTHS -->
<section class="sec" id="strengths" style="background:#0E0E0E;padding:110px 0">
  <div class="wrap reveal">
    <div style="display:flex;align-items:center;margin-bottom:44px;gap:40px">
      <div class="eye" style="color:rgba(255,255,255,.6);flex-shrink:0;font-size:18px">SERVICE ／ サービス</div>
    </div>
    <div class="heavy" style="font-size:clamp(32px,3.5vw,50px);color:#fff;margin-bottom:56px;text-align:center">4つの強み＝X (CROSS)</div>
    <div class="strengths-grid">
      <div class="strengths-col" style="text-align:right;align-items:flex-end">
        <div>
          <div class="fsh">アピール</div>
          <div class="fsd">ファンや海外の関係者に最も響くストーリーを共に作り、確かな戦略で実現します。</div>
        </div>
        <div>
          <div class="fsh">イメージ</div>
          <div class="fsd">コピーライティングを通じ、ローカライズに配慮しながら、ブランドの想いを正確に世界へ届けます。</div>
        </div>
      </div>
      <div style="display:flex;align-items:center;justify-content:center">
        <svg width="260" height="260" viewBox="0 0 320 320" fill="none" id="x-svg">
          <defs>
            <marker id="cbsah" markerWidth="4" markerHeight="4" refX="2.4" refY="2" orient="auto" markerUnits="strokeWidth">
              <path d="M0,0 L4,2 L0,4 Z" fill="#C41230"></path>
            </marker>
          </defs>
          <line x1="150" y1="150" x2="58" y2="58" stroke="#C41230" stroke-width="15" marker-end="url(#cbsah)"></line>
          <line x1="170" y1="150" x2="262" y2="58" stroke="#C41230" stroke-width="15" marker-end="url(#cbsah)"></line>
          <line x1="150" y1="170" x2="58" y2="262" stroke="#C41230" stroke-width="15" marker-end="url(#cbsah)"></line>
          <line x1="170" y1="170" x2="262" y2="262" stroke="#C41230" stroke-width="15" marker-end="url(#cbsah)"></line>
          <circle cx="160" cy="160" r="26" fill="#0E0E0E" stroke="#C41230" stroke-width="2.5"></circle>
          <text x="160" y="160" text-anchor="middle" dominant-baseline="central" font-size="24" font-weight="900" fill="#C41230">×</text>
        </svg>
      </div>
      <div class="strengths-col" style="text-align:left;align-items:flex-start">
        <div>
          <div class="fsh">インパクト</div>
          <div class="fsd">海外向けの発信内容をすべて確認し、伝え方・トーン・必要な情報を整えます。</div>
        </div>
        <div>
          <div class="fsh">カルチャー</div>
          <div class="fsd">日本の文化や価値観を大切にしながら、届けたいメッセージを相手に響く形で伝えます。</div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ⑧ SERVICES -->
<section class="sec" id="services" style="background:#0E0E0E;padding:110px 0">
  <div class="wrap reveal">
