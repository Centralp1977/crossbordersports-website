        <div class="jtitle" style="margin-top:18px">スタッフインタビュー：Abby Hall</div>
        <div class="g" style="margin-top:10px;font-size:11px;color:rgba(14,14,14,.5);font-weight:500">2025.12.17</div>
        <div style="display:flex;gap:10px;margin-top:12px">
