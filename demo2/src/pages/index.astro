    <div class="m" style="margin-top:18px;font-size:17px;color:rgba(255,255,255,.8)">戦略を立てる、発信する、メディアに届ける。</div>

    <!-- Service 01 -->
    <div class="svrow" style="margin-top:64px">
      <div class="svcard">
        <div class="ph" style="width:100%;height:200px;border-radius:6px">
          <div class="phcap">［ strategy session ］</div>
        </div>
        <div class="heavy" style="font-size:20px;margin-top:22px;color:#fff">戦略を立てる</div>
      </div>
      <div class="svdetail">
        <div class="eye cr">CATEGORY 01</div>
        <div class="heavy" style="font-size:36px;margin-top:10px;color:#fff">戦略を立てる</div>
        <div class="m" style="margin-top:14px;font-size:15px;line-height:1.85;color:rgba(255,255,255,.8)">海外展開の出発点に立つ、戦略の設計。内と外の視点で勝ち筋を描く。</div>
        <div style="margin-top:26px">
          <div class="heavy" style="font-size:18px;color:#fff">グローバル戦略コンサルティング</div>
          <div class="m" style="margin-top:6px;font-size:14px;color:rgba(255,255,255,.75)">海外展開の方針立案から実行までの戦略的アドバイス。</div>
        </div>
        <div style="margin-top:20px">
          <div class="heavy" style="font-size:18px;color:#fff">海外ステークホルダー調整</div>
          <div class="m" style="margin-top:6px;font-size:14px;color:rgba(255,255,255,.75)">国際連盟・スポンサー・パートナーとの関係構築。</div>
        </div>
      </div>
    </div>

    <div class="svrule"></div>

    <!-- Service 02 -->
    <div class="svrow">
      <div class="svcard">
        <div class="ph" style="width:100%;height:200px;border-radius:6px">
          <div class="phcap">［ filming a moment ］</div>
        </div>
        <div class="heavy" style="font-size:20px;margin-top:22px;color:#fff">発信する</div>
      </div>
      <div class="svdetail">
        <div class="eye cr">CATEGORY 02</div>
        <div class="heavy" style="font-size:36px;margin-top:10px;color:#fff">発信する</div>
        <div class="m" style="margin-top:14px;font-size:15px;line-height:1.85;color:rgba(255,255,255,.8)">英語ネイティブの手で、熱を世界に届く言葉に変える。</div>
        <div style="margin-top:26px">
          <div class="heavy" style="font-size:18px;color:#fff">英語SNS運用・コンテンツ制作</div>
          <div class="m" style="margin-top:6px;font-size:14px;color:rgba(255,255,255,.75)">英語ネイティブが手がける投稿作成・アカウント運用。</div>
        </div>
        <div style="margin-top:20px">
          <div class="heavy" style="font-size:18px;color:#fff">英語プレスリリース作成・翻訳</div>
          <div class="m" style="margin-top:6px;font-size:14px;color:rgba(255,255,255,.75)">伝わる英語で書いたプレスリリースと自然な翻訳。</div>
        </div>
      </div>
    </div>

    <div class="svrule"></div>

    <!-- Service 03 -->
    <div class="svrow">
      <div class="svcard">
        <div class="ph" style="width:100%;height:200px;border-radius:6px">
          <div class="phcap">［ press conference ］</div>
        </div>
        <div class="heavy" style="font-size:20px;margin-top:22px;color:#fff">メディアに届ける</div>
      </div>
      <div class="svdetail">
        <div class="eye cr">CATEGORY 03</div>
        <div class="heavy" style="font-size:36px;margin-top:10px;color:#fff">メディアに届ける</div>
        <div class="m" style="margin-top:14px;font-size:15px;line-height:1.85;color:rgba(255,255,255,.8)">世界のメディアに、正しく強く届ける接点を設計する。</div>
        <div style="margin-top:26px">
          <div class="heavy" style="font-size:18px;color:#fff">海外メディア対応・PR支援</div>
          <div class="m" style="margin-top:6px;font-size:14px;color:rgba(255,255,255,.75)">海外メディアへのアプローチから取材対応まで。</div>
        </div>
        <div style="margin-top:20px">
          <div class="heavy" style="font-size:18px;color:#fff">海外メディアトレーニング</div>
          <div class="m" style="margin-top:6px;font-size:14px;color:rgba(255,255,255,.75)">取材・インタビュー・登壇に向けた実践的トレーニング。</div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ⑨ JOURNAL -->
<section class="sec" id="journal" style="background:#F3F1EC;padding:110px 0">
  <div class="wrap reveal">
    <div style="display:flex;align-items:center;margin-bottom:44px;gap:32px;flex-wrap:wrap">
      <div class="eye" style="color:#0E0E0E;flex-shrink:0;font-size:18px">JOURNAL ／ ニュース</div>
      <div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap">
