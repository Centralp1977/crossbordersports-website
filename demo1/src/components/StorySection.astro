---
---
<section id="story" class="w-full grid" style="grid-template-columns: 55% 45%; background: var(--ink);">

  <!-- Text (left) -->
  <div class="px-20 py-[120px]">
    <div class="lab mb-9 reveal-up" style="color:var(--crimson);">Story ／ 物語</div>

    <h2 class="mincho text-white font-semibold leading-[1.4] mb-7 reveal-up"
      style="font-size:48px;">
      日本のスポーツファンに、<br>恋をした。
    </h2>

    <p class="gothic text-white font-bold text-[14px] tracking-[0.18em] mb-9 reveal-up">── ABBY HALL</p>

    <p class="mincho text-white/90 text-[16px] leading-[1.9] max-w-[460px] mb-10 reveal-up">
      ある日、彼女はスタジアムで日本のファンに出会い、その熱狂に心を奪われた。外からの視点だからこそ見える、日本のスポーツの本質的な美しさ。
    </p>

    <a href="#" class="gothic text-white font-bold text-[15px] inline-block reveal-up
      border-b-2 pb-1 hover:opacity-70 transition-opacity duration-200 w-fit"
      style="border-color:var(--crimson);">
      ロングインタビューを読む →
    </a>
  </div>

  <!-- Portrait placeholder (right) -->
  <div class="ph min-h-[620px]" style="filter:brightness(.8);">
    <div class="phcap">PORTRAIT — ABBY (CINEMATIC)</div>
  </div>
</section>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  document.querySelectorAll('#story .reveal-up').forEach((el, i) => {
    gsap.to(el, {
      opacity: 1,
      y: 0,
      duration: 0.75,
      ease: 'power3.out',
      delay: i * 0.12,
      scrollTrigger: {
        trigger: '#story',
        start: 'top 78%',
      },
    });
  });
</script>
