---
// Philosophy — readable two-column statement with a subtle giant X
// behind the content. Stacks to single column on tablet / mobile.
---
<section id="philosophy" class="relative w-full overflow-hidden"
  style="background: var(--ink); padding: clamp(72px, 10vw, 140px) clamp(20px, 6vw, 96px);">

  <!-- Subtle background X (decorative only, behind everything) -->
  <div id="big-x"
    class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 z-[0]
      gothic font-black select-none leading-none pointer-events-none"
    style="font-size: clamp(280px, 50vw, 540px); color: var(--crimson); opacity: 0.08;">
    ✕
  </div>

  <!-- Label -->
  <div class="lab relative z-10 text-center mb-12 md:mb-16 text-white tracking-[0.5em] opacity-85 reveal-up">
    PHILOSOPHY
  </div>

  <!-- Two-column statements — stacks on mobile / tablet -->
  <div class="relative z-10 grid grid-cols-1 md:grid-cols-2 gap-10 md:gap-16 lg:gap-24 max-w-[1080px] mx-auto items-center">

    <div class="text-center md:text-left reveal-up">
      <div class="gothic font-black text-white leading-[1.2]"
        style="font-size: clamp(28px, 4vw, 44px); text-shadow: 0 2px 30px rgba(0,0,0,0.5);">
        外からの視点
      </div>
      <div class="bebas text-white/40 mt-3 tracking-[0.2em]" style="font-size: 13px;">
        OUTSIDE PERSPECTIVE
      </div>
    </div>

    <div class="text-center md:text-right reveal-up">
      <div class="gothic font-black text-white leading-[1.2]"
        style="font-size: clamp(28px, 4vw, 44px); text-shadow: 0 2px 30px rgba(0,0,0,0.5);">
        日本への深い理解
      </div>
      <div class="bebas text-white/40 mt-3 tracking-[0.2em]" style="font-size: 13px;">
        DEEP UNDERSTANDING OF JAPAN
      </div>
    </div>
  </div>

  <!-- Quote -->
  <div class="relative z-10 mincho text-white text-center italic opacity-90 reveal-up
    mt-14 md:mt-20"
    style="font-size: clamp(15px, 1.6vw, 20px);">
    だからこそ、私たちにできることがある。
  </div>
</section>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  gsap.fromTo('#big-x',
    { scale: 0.7, opacity: 0 },
    {
      scale: 1, opacity: 0.08, duration: 1.4, ease: 'expo.out',
      scrollTrigger: { trigger: '#philosophy', start: 'top 75%' },
    }
  );

  gsap.to('#big-x', {
    rotation: 8, duration: 10, ease: 'sine.inOut', yoyo: true, repeat: -1,
  });

  document.querySelectorAll('#philosophy .reveal-up').forEach((el, i) => {
    gsap.to(el, {
      opacity: 1, y: 0, duration: 0.8, ease: 'power3.out',
      delay: i * 0.12 + 0.15,
      scrollTrigger: { trigger: '#philosophy', start: 'top 75%' },
    });
  });
</script>
