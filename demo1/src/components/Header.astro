---
---
<header id="site-header" class="fixed top-0 left-0 right-0 z-50 transition-all duration-500"
  style="transform: translateY(-100%); opacity: 0; pointer-events: none;">
  <div class="max-w-[1440px] mx-auto">
    <nav class="flex items-center justify-between px-12 h-[72px]"
      style="background: rgba(0,0,0,0.35); backdrop-filter: blur(6px);">

      <!-- Logo -->
      <a href="#" class="flex items-center gap-2.5">
        <!-- CBS badge mark -->
        <div class="w-[42px] h-[42px] rounded-full border-2 flex items-center justify-center flex-shrink-0 overflow-hidden"
          style="border-color: var(--crimson); background: rgba(196,18,48,0.15);">
          <svg width="22" height="22" viewBox="0 0 22 22" fill="none">
            <circle cx="11" cy="11" r="8" stroke="white" stroke-width="1.2"/>
            <line x1="4" y1="4" x2="18" y2="18" stroke="white" stroke-width="1.4" stroke-linecap="round"/>
            <line x1="18" y1="4" x2="4" y2="18" stroke="white" stroke-width="1.4" stroke-linecap="round"/>
          </svg>
        </div>
        <div class="leading-tight">
          <div class="gothic text-white font-black text-[13px] tracking-[0.12em]">CROSSBORDER</div>
          <div class="gothic text-white font-black text-[13px] tracking-[0.12em]">SPORTS</div>
        </div>
      </a>

      <!-- Nav links (English) -->
      <div class="flex items-center gap-10">
        {[
          { label: 'About Us',  href: '#about' },
          { label: 'Services',  href: '#services' },
          { label: 'Works',     href: '#story' },
          { label: 'Journal',   href: '#' },
          { label: 'Contact',   href: '#contact' },
        ].map(({ label, href }) => (
          <a href={href}
            class="gothic text-white font-medium text-[14px] tracking-[0.06em] opacity-90
              hover:opacity-100 hover:text-[var(--crimson)] transition-colors duration-200 relative group">
            {label}
            <span class="absolute -bottom-0.5 left-0 w-0 h-[1.5px] bg-[var(--crimson)]
              group-hover:w-full transition-all duration-300 ease-out"></span>
          </a>
        ))}
      </div>

      <!-- Spacer to balance logo -->
      <div class="w-[120px]"></div>
    </nav>
  </div>
</header>

<script>
  const header = document.getElementById('site-header') as HTMLElement;
  const nav = header.querySelector('nav') as HTMLElement;

  function onScroll() {
    // Reveal the sticky header only after scrolling past the hero visual,
    // since the hero image already contains its own nav.
    const heroEl = document.querySelector('.hero-section') as HTMLElement | null;
    const trigger = heroEl ? heroEl.offsetHeight * 0.85 : 600;

    if (window.scrollY > trigger) {
      header.style.transform = 'translateY(0)';
      header.style.opacity = '1';
      header.style.pointerEvents = 'auto';
      nav.style.background = 'rgba(0,0,0,0.9)';
    } else {
      header.style.transform = 'translateY(-100%)';
      header.style.opacity = '0';
      header.style.pointerEvents = 'none';
    }
  }

  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();
</script>
