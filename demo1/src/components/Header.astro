---
---
<header id="site-header" class="fixed top-0 left-0 right-0 z-50 transition-all duration-300">
  <div class="max-w-[1440px] mx-auto">
    <!-- Black top bar -->
    <div class="h-[28px] bg-black"></div>

    <!-- Nav bar -->
    <nav class="flex items-center justify-between px-14 h-[68px] bg-black/60 backdrop-blur-sm border-b border-white/5">
      <!-- Logo -->
      <a href="#" class="flex items-center gap-3">
        <div class="w-[30px] h-[30px] border border-white rounded-full flex items-center justify-center text-[var(--crimson)] font-black text-sm">
          ✕
        </div>
        <div>
          <div class="gothic text-white font-black text-[15px] tracking-[0.14em]">CROSSBORDER SPORTS</div>
          <div class="mincho text-white/65 text-[10px] tracking-[0.08em] mt-0.5">日本×文化＝スポーツをつくる会社</div>
        </div>
      </a>

      <!-- Nav links -->
      <div class="flex items-center gap-8">
        {['会社概要', 'サービス', '実績', 'ジャーナル'].map(link => (
          <a href="#" class="gothic text-white font-bold text-[14px] tracking-[0.12em] hover:text-[var(--crimson)] transition-colors duration-200 relative group">
            {link}
            <span class="absolute bottom-0 left-0 w-0 h-[1px] bg-[var(--crimson)] group-hover:w-full transition-all duration-300"></span>
          </a>
        ))}
      </div>

      <!-- Right -->
      <div class="flex items-center gap-5">
        <span class="gothic text-white font-bold text-[13px] tracking-[0.1em] opacity-70 hover:opacity-100 transition-opacity">
          JP / EN
        </span>
        <a href="#contact" class="bg-[var(--crimson)] text-white gothic font-bold text-[13px] px-5 py-2.5 tracking-[0.06em] hover:bg-[#a00f26] transition-colors duration-200">
          お問い合わせ
        </a>
      </div>
    </nav>
  </div>
</header>

<script>
  const header = document.getElementById('site-header')!;
  window.addEventListener('scroll', () => {
    if (window.scrollY > 60) {
      header.querySelector('nav')!.classList.add('bg-black/90');
      header.querySelector('nav')!.classList.remove('bg-black/60');
    } else {
      header.querySelector('nav')!.classList.add('bg-black/60');
      header.querySelector('nav')!.classList.remove('bg-black/90');
    }
  });
</script>
