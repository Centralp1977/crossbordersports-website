---
---
<footer class="w-full px-20" style="background:var(--ink);">
  <div class="flex items-center justify-between h-[120px] border-b border-white/10">

    <!-- Logo -->
    <div class="flex items-center gap-3">
      <div class="w-[26px] h-[26px] border border-white rounded-full flex items-center justify-center text-[13px] font-black"
        style="color:var(--crimson);">✕</div>
      <span class="gothic text-white font-black text-[13px] tracking-[0.12em]">CROSSBORDER SPORTS</span>
    </div>

    <!-- Nav -->
    <div class="flex items-center gap-6">
      {['会社概要', 'サービス', '実績', 'ジャーナル', 'お問い合わせ'].map(link => (
        <a href="#" class="gothic text-white/70 text-[12px] hover:text-white transition-colors duration-200">{link}</a>
      ))}
    </div>

    <!-- Social -->
    <div class="flex items-center gap-3">
      {['IG', 'X', 'Note'].map(s => (
        <a href="#" class="w-9 h-9 border border-white/50 flex items-center justify-center
          text-white text-[11px] tracking-[0.05em] hover:border-white transition-colors duration-200">
          {s}
        </a>
      ))}
    </div>
  </div>

  <div class="gothic text-white/40 text-center text-[10px] tracking-[0.1em] py-7">
    © 2026 CROSSBORDER SPORTS. All rights reserved.
  </div>
</footer>
