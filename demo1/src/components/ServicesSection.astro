---
const services = [
  {
    cat: '戦略を立てる',
    catEn: 'STRATEGY',
    items: [
      { title: 'グローバル戦略コンサルティング',     desc: '海外展開の方針立案から実行までの戦略的アドバイス。' },
      { title: '海外ステークホルダー調整',           desc: '国際連盟・スポンサー・パートナーとの関係構築。' },
    ],
  },
  {
    cat: '発信する',
    catEn: 'BROADCAST',
    items: [
      { title: '英語SNS運用・コンテンツ制作',         desc: '英語ネイティブが手がける投稿作成・アカウント運用。' },
      { title: '英語プレスリリース作成・翻訳',         desc: '伝わる英語で書いたプレスリリースと自然な翻訳。' },
    ],
  },
  {
    cat: 'メディアに届ける',
    catEn: 'MEDIA',
    items: [
      { title: '海外メディア対応・PR支援',            desc: '海外メディアへのアプローチから取材対応まで。' },
      { title: '海外メディアトレーニング',            desc: '取材・インタビュー・登壇に向けた実践的トレーニング。' },
    ],
  },
];
---
<section id="services" style="background: var(--paper); padding: clamp(72px, 9vw, 120px) clamp(20px, 6vw, 80px);">

  <div class="max-w-[960px] mx-auto">

    <div class="lab mb-5 reveal-up" style="color: var(--ink);">Services ／ サービス</div>

    <h2 class="h900 reveal-up mb-4"
      style="font-size: clamp(28px, 4vw, 48px); color: var(--ink); line-height: 1.25;">
      熱を、世界の言語に翻訳する。
    </h2>

    <p class="mincho reveal-up mb-14 md:mb-20"
      style="font-size: clamp(15px, 1.6vw, 18px); color: var(--ink); opacity: 0.85; line-height: 1.7;">
      戦略を立てる、発信する、メディアに届ける。
    </p>

    <!-- Vertical stack: 3 service cards in a single column -->
    <div class="flex flex-col gap-7 md:gap-10">
      {services.map((svc, idx) => (
        <article class="bg-white reveal-up
          border border-[var(--ink)]/10 hover:border-[var(--crimson)]
          transition-colors duration-300
          p-7 md:p-10 lg:p-12">

          <!-- Card header -->
          <div class="flex items-center gap-4 mb-7">
            <span class="bebas leading-none"
              style="color: var(--crimson); font-size: clamp(22px, 2.4vw, 28px);">
              0{idx + 1}
            </span>
            <div class="h-[2px] flex-1" style="background: var(--crimson);"></div>
            <span class="bebas tracking-[0.22em]"
              style="font-size: 12px; color: var(--ink); opacity: 0.5;">
              {svc.catEn}
            </span>
          </div>

          <h3 class="h900 mb-7"
            style="font-size: clamp(22px, 2.6vw, 30px); color: var(--ink);">
            {svc.cat}
          </h3>

          <!-- Items inside the card -->
          <ul class="flex flex-col divide-y" style="border-color: rgba(14,14,14,0.1);">
            {svc.items.map((item) => (
              <li class="py-5 first:pt-0 last:pb-0">
                <div class="h900 mb-2"
                  style="font-size: clamp(16px, 1.6vw, 19px); color: var(--ink); line-height: 1.45;">
                  {item.title}
                </div>
                <p class="mincho leading-[1.85]"
                  style="font-size: clamp(13px, 1.3vw, 15px); color: var(--ink); opacity: 0.8;">
                  {item.desc}
                </p>
              </li>
            ))}
          </ul>
        </article>
      ))}
    </div>
  </div>
</section>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  document.querySelectorAll('#services .reveal-up').forEach((el, i) => {
    gsap.to(el, {
      opacity: 1, y: 0, duration: 0.7, ease: 'power3.out',
      delay: (i % 6) * 0.1,
      scrollTrigger: { trigger: el, start: 'top 88%' },
    });
  });
</script>
