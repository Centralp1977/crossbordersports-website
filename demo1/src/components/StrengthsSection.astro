---
const strengths = [
  { num: '01', ja: 'カルチャー', en: 'Culture', desc: '日本のスポーツ文化を、世界の文脈に翻訳する。' },
  { num: '02', ja: 'インパクト', en: 'Impact',  desc: '感情を動かすコンテンツで、熱狂を設計する。' },
  { num: '03', ja: 'アピール',   en: 'Appeal',  desc: '日本のスポーツの魅力を、最大化して届ける。' },
  { num: '04', ja: 'イメージ',   en: 'Image',   desc: '世界が抱く"日本"のイメージを、スポーツで塗り替える。' },
];
---
<section id="strengths" style="background: var(--paper); padding: clamp(72px, 9vw, 120px) clamp(20px, 6vw, 80px);">

  <div class="max-w-[1240px] mx-auto">

    <div class="lab mb-5 reveal-up" style="color: var(--ink);">Four Strengths ／ 4つの強み</div>

    <h2 class="h900 reveal-up mb-14 md:mb-20"
      style="font-size: clamp(26px, 3.2vw, 42px); color: var(--ink); max-width: 880px; line-height: 1.35;">
      感情<span style="color:var(--crimson);">×</span>戦略<span style="color:var(--crimson);">×</span>文化<span style="color:var(--crimson);">×</span>発信。<br>
      4つの交点に、CBSがいる。
    </h2>

    <!-- 1 col mobile · 2 col tablet+ -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-5 md:gap-7">
      {strengths.map((s) => (
        <article class="strength-card bg-white p-7 md:p-10 reveal-up
          border border-[var(--ink)]/10 hover:border-[var(--crimson)]
          transition-colors duration-300 group">

          <div class="flex items-baseline gap-4 mb-5">
            <span class="bebas text-[28px] md:text-[34px] leading-none"
              style="color: var(--crimson);">{s.num}</span>
            <span class="h-px flex-1" style="background: var(--ink); opacity: 0.15;"></span>
          </div>

          <h3 class="h900 mb-2" style="font-size: clamp(22px, 2.6vw, 30px); color: var(--ink);">
            {s.ja}
          </h3>
          <div class="bebas tracking-[0.22em] mb-5 text-[12px]" style="color: var(--ink); opacity: 0.55;">
            {s.en}
          </div>

          <p class="mincho leading-[1.85]"
            style="font-size: clamp(14px, 1.4vw, 16px); color: var(--ink); opacity: 0.85;">
            {s.desc}
          </p>
        </article>
      ))}
    </div>
  </div>
</section>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  document.querySelectorAll('#strengths .reveal-up').forEach((el, i) => {
    gsap.to(el, {
      opacity: 1, y: 0, duration: 0.7, ease: 'power3.out',
      delay: i * 0.1,
      scrollTrigger: { trigger: '#strengths', start: 'top 78%' },
    });
  });
</script>
