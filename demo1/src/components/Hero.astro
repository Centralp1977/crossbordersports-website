---
const base = import.meta.env.BASE_URL;
---
<section class="hero-section relative w-full overflow-hidden" style="background:#04111c;">

  <!-- Full hero visual — aspect-ratio matches the image (1200×675) so cover
       never needs to scale beyond the image width, preventing horizontal clipping. -->
  <div
    id="hero-main"
    role="img"
    aria-label="スポーツといえば日本を世界へ届ける — CROSSBORDER SPORTS"
    class="w-full hero-img"
    style={`background-image: url('${base}images/hero-main.jpg'); background-size: cover; background-position: center center; background-repeat: no-repeat;`}
  ></div>

  <!-- Scroll indicator -->
  <div class="absolute left-1/2 -translate-x-1/2 bottom-6 z-[8] flex flex-col items-center pointer-events-none">
    <div id="scroll-line" class="w-px h-8 bg-white/70 origin-top"></div>
  </div>
</section>

<style>
  .hero-img {
    /* Match image aspect ratio (1200×675 = 16:9) so cover never clips the sides */
    aspect-ratio: 1200 / 675;
    /* Never taller than the viewport */
    max-height: 100vh;
    /* Keep a minimum height on narrow screens */
    min-height: 400px;
  }
  @media (max-width: 640px) {
    .hero-img { min-height: 360px; }
  }
</style>

<script>
  import { gsap } from 'gsap';

  gsap.fromTo('#hero-main',
    { opacity: 0, scale: 1.04 },
    { opacity: 1, scale: 1, duration: 1.2, ease: 'power2.out' }
  );

  gsap.to('#scroll-line', {
    scaleY: 0,
    duration: 0.8,
    ease: 'power2.in',
    repeat: -1,
    repeatDelay: 0.4,
  });
</script>
