---
// Hero visual — display the finished design image (hero-src2) as-is.
---
<section class="hero-section relative w-full overflow-hidden" style="background:#04111c;">

  <!-- Full hero visual, shown at its natural 16:9 ratio (no overlays, no crop) -->
  <img
    id="hero-main"
    src="/images/hero-main.jpg"
    alt="スポーツといえば日本を世界へ届ける — CROSSBORDER SPORTS"
    class="block w-full h-auto select-none"
    draggable="false"
  />

  <!-- Scroll indicator -->
  <div class="absolute left-1/2 -translate-x-1/2 bottom-6 z-[8] flex flex-col items-center pointer-events-none">
    <div id="scroll-line" class="w-px h-8 bg-white/60 origin-top"></div>
  </div>
</section>

<script>
  import { gsap } from 'gsap';

  // Gentle fade + zoom-settle on load (image itself is shown unaltered)
  gsap.fromTo('#hero-main',
    { opacity: 0, scale: 1.04 },
    { opacity: 1, scale: 1, duration: 1.2, ease: 'power2.out' }
  );

  // Scroll line pulse
  gsap.to('#scroll-line', {
    scaleY: 0,
    duration: 0.8,
    ease: 'power2.in',
    repeat: -1,
    repeatDelay: 0.4,
  });
</script>
