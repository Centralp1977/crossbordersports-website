---
---
<section class="hero-section relative w-full h-[800px] overflow-hidden bg-[var(--navy)]">

  <!-- Three.js particle canvas -->
  <canvas id="hero-canvas" class="absolute inset-0 w-full h-full z-10 pointer-events-none opacity-40"></canvas>

  <!-- Hero background image -->
  <div
    id="hero-bg"
    class="absolute inset-0 bg-center bg-cover"
    style="background-image: url('/images/hero-bg.jpg');"
  ></div>

  <!-- Gradient overlay: left dark → right transparent -->
  <div class="absolute inset-0 z-[2]"
    style="background: linear-gradient(90deg, rgba(6,16,24,.95) 0%, rgba(6,16,24,.72) 42%, rgba(6,16,24,.15) 74%, rgba(6,16,24,0) 100%);">
  </div>

  <!-- Red X decoration (brand mark) -->
  <div class="absolute right-[6%] top-[12%] z-[3] opacity-80" aria-hidden="true">
    <svg width="320" height="320" viewBox="0 0 320 320" fill="none">
      <line x1="0" y1="0" x2="320" y2="320" stroke="#C41230" stroke-width="5" stroke-linecap="square"/>
      <line x1="320" y1="0" x2="0" y2="320" stroke="#C41230" stroke-width="5" stroke-linecap="square"/>
    </svg>
  </div>

  <!-- Vertical label -->
  <div class="absolute right-8 bottom-32 z-[6] writing-mode-vert text-white/50 text-[11px] tracking-[0.3em] bebas"
    style="writing-mode: vertical-rl; letter-spacing: 0.3em;">
    A-HERO 01 / VORTEX OF JOY
  </div>

  <!-- Hero body content -->
  <div id="hero-body" class="absolute left-20 bottom-36 z-[6] max-w-[700px]">

    <!-- Tagline row -->
    <div class="flex items-center gap-4 mb-7 hero-line" style="opacity:0; transform:translateY(20px);">
      <span class="rule"></span>
      <span class="lab text-white">SPORTS PR FROM JAPAN, TO THE WORLD</span>
    </div>

    <!-- Main headline -->
    <h1 class="gothic font-black leading-[1.04] tracking-[-0.02em] text-white mb-5">
      <span class="block hero-line" style="font-size:72px; opacity:0; transform:translateY(24px);">スポーツと言えば、</span>
      <span class="block hero-line" style="font-size:72px; opacity:0; transform:translateY(24px);">
        日本<span style="color:var(--crimson); font-size:84px;">✕</span>をつくる。
      </span>
    </h1>

    <!-- Sub copy -->
    <p class="gothic text-white text-[17px] leading-[1.7] mb-3 hero-line" style="opacity:0; transform:translateY(20px);">
      日本のスポーツの熱を、戦略で世界へ届けるPRカンパニー。
    </p>

    <!-- Byline -->
    <p class="bebas text-white/50 text-[11px] tracking-[0.18em] mb-8 hero-line" style="opacity:0; transform:translateY(16px);">
      CROSSBORDER SPORTS &nbsp;|&nbsp; representative / Abby Hall
    </p>

    <!-- CTA buttons -->
    <div class="flex items-center gap-4 hero-line" style="opacity:0; transform:translateY(16px);">
      <a href="#contact"
        class="bg-[var(--crimson)] text-white gothic font-bold text-[14px] px-8 py-3.5 tracking-[0.06em] flex items-center gap-2 hover:bg-[#a00f26] transition-colors duration-200 whitespace-nowrap">
        お問い合わせ <span class="text-base">→</span>
      </a>
      <a href="#services"
        class="border border-white text-white gothic font-bold text-[14px] px-8 py-3.5 tracking-[0.06em] hover:bg-white/10 transition-colors duration-200 whitespace-nowrap">
        サービスを見る
      </a>
    </div>
  </div>

  <!-- Scroll indicator -->
  <div class="absolute left-1/2 -translate-x-1/2 bottom-8 z-[8] flex flex-col items-center text-white">
    <div id="scroll-line" class="w-px h-8 bg-white/70 mt-2 origin-top"></div>
  </div>

  <!-- Bottom trusted bar -->
  <div class="absolute left-0 right-0 bottom-0 z-[6] bg-black h-[28px]"></div>
</section>

<script>
  import * as THREE from 'three';
  import { gsap } from 'gsap';

  // ── Three.js particle field ──────────────────────────────────────
  const canvas = document.getElementById('hero-canvas') as HTMLCanvasElement;
  const renderer = new THREE.WebGLRenderer({ canvas, alpha: true, antialias: false });
  renderer.setPixelRatio(Math.min(window.devicePixelRatio, 1.5));
  renderer.setSize(canvas.offsetWidth, canvas.offsetHeight);

  const scene = new THREE.Scene();
  const camera = new THREE.PerspectiveCamera(60, canvas.offsetWidth / canvas.offsetHeight, 0.1, 100);
  camera.position.z = 4;

  // Particles
  const count = 140;
  const positions = new Float32Array(count * 3);
  for (let i = 0; i < count; i++) {
    positions[i * 3]     = (Math.random() - 0.5) * 14;
    positions[i * 3 + 1] = (Math.random() - 0.5) * 8;
    positions[i * 3 + 2] = (Math.random() - 0.5) * 4;
  }
  const geo = new THREE.BufferGeometry();
  geo.setAttribute('position', new THREE.BufferAttribute(positions, 3));
  const mat = new THREE.PointsMaterial({ color: 0xffffff, size: 0.04, transparent: true, opacity: 0.6 });
  scene.add(new THREE.Points(geo, mat));

  let mouseX = 0, mouseY = 0;
  document.addEventListener('mousemove', (e) => {
    mouseX = (e.clientX / window.innerWidth  - 0.5) * 0.5;
    mouseY = (e.clientY / window.innerHeight - 0.5) * 0.3;
  });

  function renderLoop() {
    requestAnimationFrame(renderLoop);
    camera.position.x += (mouseX - camera.position.x) * 0.04;
    camera.position.y += (-mouseY - camera.position.y) * 0.04;
    renderer.render(scene, camera);
  }
  renderLoop();

  window.addEventListener('resize', () => {
    renderer.setSize(canvas.offsetWidth, canvas.offsetHeight);
    camera.aspect = canvas.offsetWidth / canvas.offsetHeight;
    camera.updateProjectionMatrix();
  });

  // ── Hero parallax ───────────────────────────────────────────────
  const heroBg = document.getElementById('hero-bg')!;
  window.addEventListener('scroll', () => {
    const y = window.scrollY * 0.3;
    heroBg.style.transform = `translateY(${y}px)`;
  }, { passive: true });

  // ── Hero text entry animation ────────────────────────────────────
  const lines = document.querySelectorAll('.hero-line');
  gsap.to(lines, {
    opacity: 1,
    y: 0,
    duration: 0.8,
    ease: 'power3.out',
    stagger: 0.12,
    delay: 0.3,
  });

  // Scroll line pulse
  gsap.to('#scroll-line', {
    scaleY: 0,
    duration: 0.8,
    ease: 'power2.in',
    repeat: -1,
    repeatDelay: 0.4,
  });
</script>
