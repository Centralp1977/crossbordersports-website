---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Ticker from '../components/Ticker.astro';
import AboutSection from '../components/AboutSection.astro';
import PhilosophySection from '../components/PhilosophySection.astro';
import StrengthsSection from '../components/StrengthsSection.astro';
import ServicesSection from '../components/ServicesSection.astro';
import StorySection from '../components/StorySection.astro';
import CTASection from '../components/CTASection.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
---
<Layout title="CROSSBORDER SPORTS — 日本のスポーツを、世界へ。">
  <Header />
  <main class="page-wrap">
    <Hero />
    <Ticker />
    <AboutSection />
    <PhilosophySection />
    <StrengthsSection />
    <ServicesSection />
    <StorySection />
    <CTASection />
    <Footer />
